{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "rush",
  "version": "0.1.0",
  "identifier": "com.rush.dev",
  "build": {
    "frontendDist": "../apps/editor/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm --filter editor dev",
    "beforeBuildCommand": "pnpm --filter editor build"
  },
  "app": {
    "windows": [
      {
        "title": "Rush Editor",
        "width": 800,
        "height": 600,
        "resizable": true,
        "fullscreen": false,
        "maximized": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      },
      "headers": {
        "Access-Control-Allow-Headers": "Origin, X-Requested-With, Content-Type, Accept, Range",
        "Access-Control-Allow-Methods": "GET, HEAD, OPTIONS"
      }
    }
  },
  "bundle": {
    "active": true,
    "externalBin": ["binaries/ffmpeg"],
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
